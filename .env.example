APP_NAME="Sistema Web COEDE"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Lima
APP_SECRET=your_app_secret_here

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coede_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Demostración / Adaptadores
DEMO_MODE=true
VISITOR_API_PROVIDER=reniec_api
DNI_API_URL=https://api.apis.net.pe/v2/reniec/dni
DNI_API_TOKEN=your_token_here
NEWS_API_PROVIDER=mock_sid_rss

# Almacenamiento seguro
STORAGE_PATH=storage/
SESSION_LIFETIME_MINUTES=15
SESSION_WARNING_MINUTES=14

